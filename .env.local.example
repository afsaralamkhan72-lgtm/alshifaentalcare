# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only — never expose to the browser.
# REQUIRED for the patient portal (Settings -> API -> secret key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OPTIONAL (na likhein to software khud theek chalata hai). Staff portal ke liye lamba random text.
STAFF_PORTAL_SECRET=koi-lamba-random-text-yahan-likhein

# OPTIONAL (na likhein to alshifahomeoanddentalcare.com istemal hota hai)
NEXT_PUBLIC_SITE_URL=https://alshifahomeoanddentalcare.com
